/*
    ROCm packages
    rocmPackages.* + packages that differ when enableRocm is on
    list of those packages was generated with some shoddy scripting and
    there is probably a better solution in this repo somewhere that i need
    pointed at
    see ./release-rocm-gen.sh for shoddy scripting

    Test for example like this:

        $ nix-eval-jobs --force-recurse pkgs/top-level/release-rocm.nix -I .
*/

let
  lib = import ../../lib;
in

{
  # The platforms for which we build Nixpkgs.
  supportedSystems ? [
    "x86_64-linux"
    # TODO(@LunNova)
    # "aarch64-linux"
  ],
  # Attributes passed to nixpkgs.
  nixpkgsArgs ? {
    config = {
      rocmSupport = true;
      inHydra = true;

      # Don't evaluate duplicate and/or deprecated attributes
      allowAliases = false;
    };

    __allowFileset = false;
  },
  ...
}@args:

let
  mkReleaseLib = import ./release-lib.nix;
  release-lib = mkReleaseLib (
    { inherit supportedSystems nixpkgsArgs; } // lib.intersectAttrs (lib.functionArgs mkReleaseLib) args
  );

  inherit (release-lib)
    linux
    mapTestOn
    packagePlatforms
    pkgs
    ;
  rocmPlatforms = packagePlatforms pkgs.rocmPackages.clr;

  # Package sets to evaluate whole
  # Derivations from these package sets are selected based on the value
  # of their meta.{hydraPlatforms,platforms,badPlatforms} attributes
  autoPackagePlatforms = lib.genAttrs [ "rocmPackages_6" ] (pset: packagePlatforms pkgs.${pset});

